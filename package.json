{
  "name": "nextlimiter",
  "version": "1.0.5",
  "description": "Production-ready rate limiting for Node.js — sliding window, token bucket, SaaS plans, smart limiting, and built-in analytics.",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": "./src/index.js",
    "./fastify": "./src/adapters/fastify.js",
    "./next": "./src/adapters/next.js",
    "./hono": "./src/adapters/hono.js"
  },
  "files": [
    "src/",
    "types/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "jest --watch",
    "lint": "eslint src/ --ext .js",
    "example": "node examples/express-app.js"
  },
  "keywords": [
    "rate-limit",
    "rate-limiter",
    "express",
    "middleware",
    "token-bucket",
    "sliding-window",
    "redis",
    "saas",
    "api",
    "throttle",
    "nodejs"
  ],
  "author": "Abhishek <abhishek.ck3110@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0",
    "ioredis": ">=4.0.0",
    "fastify": ">=4.0.0",
    "fastify-plugin": ">=4.0.0",
    "hono": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "fastify-plugin": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "express": "^4.18.2",
    "jest": "^29.0.0",
    "supertest": "^6.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhishekck31/nexlimiter.git"
  },
  "bugs": {
    "url": "https://github.com/abhishekck31/nexlimiter/issues"
  },
  "homepage": "https://github.com/abhishekck31/nexlimiter#readme"
}
